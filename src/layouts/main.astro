---
import "../styles/global.css";
import "../styles/brutalist.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Navigation />
    <main class="main-content px-4">
      <slot />
    </main>
    <Footer />
    <!-- jQuery and Rumbler Plugin -->
    <script is:inline src="https://code.jquery.com/jquery-3.7.1.min.js"
    ></script>
    <script is:inline src="/js/rumbler.js"></script>
  </body>
</html>

<style>
  .main-content {
    margin-left: auto;
    margin-right: auto;
  }
</style>
