---
import "../styles/global.css";
import Button from "../components/Button.astro";
import Posts from "./posts/index.astro";
import Layout from "../layouts/main.astro";
const currentYear = new Date().getFullYear();
// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<Layout>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content text-center container">
      <img
        src="src/assets/svgs/Primary/Primary-White.svg"
        alt="Psyclescape Logo"
        class="logo-img spin"
      />
      <h1 id="hero-title">Psyclescape {currentYear}</h1>
      <p>FRIDAY, AUGUST 28TH - SUNDAY, AUGUST 30TH</p>
      <Button href="/events" class="cta-button cellophane-bounce"
        >View Events</Button
      >
    </div>
  </section>

  <!-- Hero Scroller Bar -->
  <div class="scroller-bar" data-scroller>
    <div class="scroller-bar__track" data-scroller-track>
      <span class="scroller-bar__item">SAVE THE DATE</span>
      <span class="scroller-bar__separator"></span>
      <span class="scroller-bar__item">SAVE THE DATE</span>
      <span class="scroller-bar__separator"></span>
      <span class="scroller-bar__item">SAVE THE DATE</span>
      <span class="scroller-bar__separator"></span>
    </div>
  </div>

  <section class="hero-article text-center">
    <div class="container">
      <p>
        <span class="icon icon--skull">A</span> weekend of psycho <span
          class="icon icon--ouija-board">bike</span
        >
        tomfoolery in the heartland of<span class="icon icon--bike"
          >Baltimore</span
        ><span class="icon icon--cat">&nbsp;</span>
      </p>
    </div>
  </section>

  <!-- Landing Article Section -->
  <section class="articles-section" id="articles">
    <h2>Latest Articles</h2>
    <div class="articles-grid">
      <article class="article-card">
        <div class="article-card__number">01</div>
        <h3>The Art of Disruption</h3>
        <p>
          Exploring the boundaries between chaos and creation in modern design
          thinking.
        </p>
        <a href="#">READ MORE →</a>
      </article>

      <article class="article-card">
        <div class="article-card__number">02</div>
        <h3>Cycles of Innovation</h3>
        <p>
          How breaking repetitive patterns leads to breakthrough moments of
          clarity.
        </p>
        <a href="#">READ MORE →</a>
      </article>

      <article class="article-card">
        <div class="article-card__number">03</div>
        <h3>Escaping the Grid</h3>
        <p>
          A brutalist manifesto on rejecting conformity and embracing raw
          expression.
        </p>
        <a href="#">READ MORE →</a>
      </article>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    background-image: url("/src/assets/images/Psycescape-homepage-Mobile.gif");
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    color: var(--color-white, #fff);
    min-height: 80vh;
    padding: 2rem 1rem;
    position: relative;
  }
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0.5rem;
  }

  .hero-article {
    background: linear-gradient(to right, #fa51a2, #ff007a);
    color: var(--auxiliary);
    padding: 2rem 1rem;
  }

  .hero-article p {
    font-family: "Roboto Slab", serif;
    font-size: 3rem;
    font-weight: 900;
    line-height: 1;
  }
  h1 {
    font-size: 3rem;
    line-height: 1;
    text-transform: capitalize;
    font-weight: 900;
    border-bottom: 0;
    margin-bottom: 0;
  }
  .logo-img {
    border: 0;
    box-shadow: none;
    width: 250px;
    height: auto;
  }

  @media (min-width: 768px) {
    .hero-section {
      background-image: url("/src/assets/images/Psycescape-homepage.gif");
      background-position: center;
      padding: 0;
      min-height: 100vh;
    }

    h1 {
      font-size: 5rem;
      line-height: normal;
    }

    .hero-article p {
      font-size: 6rem;
    }

    .hero-content {
      padding: 4rem 1rem;
    }

    .logo-img {
      width: 390px;
    }
  }
  /* ========================
     Scroller Bar
     ======================== */
  .scroller-bar {
    overflow: hidden;
    background-color: var(--auxiliary, #7b46f8);
    color: var(--color-bg, #0a0a0a);
    padding: 1rem 0;
    border-bottom: 3px solid var(--color-border, #fff);
    white-space: nowrap;
  }

  .scroller-bar__track {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    animation: scroll-left 15s linear infinite;
  }

  .scroller-bar__item {
    font-family: "Roboto Slab", serif;
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: 900;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .scroller-bar__separator {
    font-size: 1rem;
    flex-shrink: 0;
    opacity: 0.6;
  }

  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  /* ========================
     Icon Pseudo-Elements
     ======================== */
  .icon {
    display: inline-block;
    position: relative;
    flex-shrink: 0;
    margin-left: 70px;
  }

  .icon::before {
    content: "";
    display: block;
    width: 60px;
    height: 60px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    position: absolute;
    top: 0px;
    left: -70px;
  }

  @media (min-width: 768px) {
    .icon {
      margin-left: 110px;
    }

    .icon::before {
      width: 100px;
      height: 100px;
      left: -110px;
    }
  }

  /* Individual icon classes */
  .icon--bike,
  .icon--ouija-board {
    margin-left: 0;
  }

  .icon--bike::before,
  .icon--ouija-board::before {
    content: none;
  }

  @media (min-width: 768px) {
    .icon--bike,
    .icon--ouija-board {
      margin-left: 110px;
    }

    .icon--bike::before,
    .icon--ouija-board::before {
      content: "";
    }
  }

  .icon--bike::before {
    background-image: url("/src/assets/icons/Bike.png");
  }

  .icon--bomb::before {
    background-image: url("/src/assets/icons/Bomb.png");
  }

  .icon--cat::before {
    background-image: url("/src/assets/icons/Cat.png");
  }

  .icon--ouija-board::before {
    background-image: url("/src/assets/icons/Ouija%20Board.png");
  }

  .icon--rat::before {
    background-image: url("/src/assets/icons/Rat.png");
  }

  .icon--skull {
    display: block;
    margin-left: auto;
    margin-right: auto;
    width: fit-content;
    padding-top: 70px;
  }

  .icon--skull::before {
    background-image: url("/src/assets/icons/Skull.png");
    transform: translateX(80%);
  }

  @media (min-width: 768px) {
    .icon--skull {
      display: inline-block;
      margin-left: 110px;
      margin-right: 0;
      width: auto;
      padding-top: 0;
    }

    .icon--skull::before {
      left: -110px;
      transform: none;
      top: 0;
    }
  }

  .icon--tall-bike::before {
    background-image: url("/src/assets/icons/Tall%20Bike.png");
  }

  .icon--wheel::before {
    background-image: url("/src/assets/icons/Wheel.png");
  }
</style>

