---
const currentPath = Astro.url.pathname;
const currentYear = new Date().getFullYear();
---

<nav class="navbar">
  <!-- Mobile Logo (visible on mobile only) -->
  <div class="md:hidden">
    <div class="flex items-center justify-start logo">
      <button
        id="hamburger"
        class="flex flex-col gap-1 p-2 z-50 hamburger-btn"
        aria-label="Toggle menu"
      >
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
        <span class="hamburger-line"></span>
      </button>
      <p>Psyclescape {currentYear}</p>
    </div>
  </div>

  <!-- Navigation Links -->
  <ul
    id="nav-menu"
    class="nav-links md:flex fixed md:relative top-0 left-0 w-full md:w-auto h-screen md:h-auto bg-black/95 md:bg-transparent flex-col md:flex-row items-center justify-center md:justify-end pt-20 md:pt-0 -translate-x-full md:translate-x-0 transition-transform duration-300"
  >
    <li>
      <a href="/" class={currentPath === "/" ? "active hrumble" : "hrumble"}
        >Home</a
      >
    </li>
    <li>
      <a
        href="/events"
        class={currentPath === "/events" ? "active hrumble" : "hrumble"}
        >Events</a
      >
    </li>
    <li>
      <a
        href="/contactInfo"
        class={currentPath === "/contactInfo" ? "active hrumble" : "hrumble"}
        >Contact</a
      >
    </li>
  </ul>
</nav>

<script>
  const hamburger = document.getElementById("hamburger");
  const navMenu = document.getElementById("nav-menu");

  hamburger?.addEventListener("click", () => {
    navMenu?.classList.toggle("translate-x-0");
    navMenu?.classList.toggle("-translate-x-full");
    hamburger?.classList.toggle("open");
  });

  // Close menu when clicking on a link
  const navLinks = navMenu?.querySelectorAll("a");
  navLinks?.forEach((link) => {
    link.addEventListener("click", () => {
      navMenu?.classList.add("-translate-x-full");
      navMenu?.classList.remove("translate-x-0");
      hamburger?.classList.remove("open");
    });
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
  }

  .container.aurora {
    max-width: 100%;
    width: 100%;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: bold;
    color: white;
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .logo:hover {
    opacity: 0.8;
  }

  .logo-img {
    width: 80px;
    height: auto;
    margin-bottom: 0.25rem;
  }

  .logo p {
    margin-left: 0.5rem;
    font-family: "Roboto Slab", serif;
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0;
  }

  /* Hamburger Button Styles */
  .hamburger-btn {
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .hamburger-line {
    display: block;
    width: 28px;
    height: 3px;
    background-color: white;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .hamburger-btn.open .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .hamburger-btn.open .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger-btn.open .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 0;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: white;
    text-decoration: none;
    font-weight: 700;
    padding: 0.75rem 1.5rem;
    transition: background 0.3s;
    font-family: "Futura", Arial, sans-serif;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-links a:hover,
  .nav-links a.active {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .nav-links a {
      font-size: 1.5rem;
      padding: 1rem 2rem;
    }

    .nav-links li {
      width: 100%;
      text-align: center;
    }
  }
</style>
